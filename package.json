    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.9",
    "expo-linking": "~55.0.8",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-store-review": "~55.0.9",
    "expo-updates": "~55.0.15",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
